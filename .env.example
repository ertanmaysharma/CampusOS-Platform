# CampusOS Environment Variables
# Copy this to .env and fill in values for local development.
# For production, set these in your hosting platform (Render / Vercel).

# ── Database ──────────────────────────────────────────────
# Local (Docker):  postgresql://campusos:campusos@localhost:5432/campusos
# Local (manual):  postgresql://<user>:<password>@localhost:5432/campusos
# Production:      Use your Render / Neon / Supabase PostgreSQL URL
DATABASE_URL=postgresql://campusos:campusos@localhost:5432/campusos

# ── Flask ─────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-string
FLASK_ENV=development
FLASK_DEBUG=1

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-different-random-string
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend ──────────────────────────────────────────────
# Used by CORS config; on Render this should be your Vercel URL
FRONTEND_URL=http://localhost:5173

# ── Vercel Frontend ────────────────────────────────────────
# Set BACKEND_URL in Vercel env vars to your Render backend URL
# BACKEND_URL=https://your-backend.onrender.com

# ── LLM / AI (optional) ──────────────────────────────────
# Leave blank to run in demo mode without an LLM
LLM_API_KEY=
LLM_MODEL=gpt-3.5-turbo
LLM_BASE_URL=
